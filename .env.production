# Public, build-time values for the browser bundle (NEXT_PUBLIC_* is inlined by `next build`).
# Project Cloud resolves service variables only at runtime, after the build, so anything the
# client bundle needs must live here. Nothing here is secret: a Turnstile SITE key, analytics
# property ids and the Sanity project id are all visible in the shipped JavaScript by design.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAD20tNeeVYvSscWd
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-NN150VWM3V
NEXT_PUBLIC_CLARITY_PROJECT_ID=wno5wce9w4
NEXT_PUBLIC_SANITY_PROJECT_ID=88arfkvq
NEXT_PUBLIC_SANITY_DATASET=production
